---
import Icon from "@/components/Icon.astro";

const year = new Date().getFullYear();
---

<footer class="bg-surface-muted flex h-20 flex-col items-center gap-2">
	<a href="#home" class="duration-300 ease-out hover:-translate-y-1 hover:opacity-75" aria-label="Back to Top">
		<Icon name="up" class="w-6" />
	</a>

	<hr class="w-4/5" />

	<p class="text-text-secondary text-sm md:text-base">
		&copy; <span id="currentYear">{{ year }}</span> Ng Zhun Onn. All rights reserved.
	</p>
</footer>

<script is:inline>
	document.getElementById("currentYear").textContent = new Date().getFullYear();
</script>
