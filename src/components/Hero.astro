---
import Icon from "@/components/Icon.astro";
---

<section id="home" class="relative container flex min-h-[90vh] items-center justify-center">
	<div class="text-center">
		<h1 class="mb-4 text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl">Ng Zhun Onn</h1>

		<p class="text-text-muted text-lg font-light md:text-xl lg:text-2xl">Student. Developer. FOSS enthusiast</p>
	</div>

	<div class="absolute bottom-6 px-2 motion-reduce:hover:animate-bounce" aria-label="Scroll down to see more">
		<Icon name="up" class="w-6 rotate-180 motion-safe:animate-bounce" />
	</div>
</section>
