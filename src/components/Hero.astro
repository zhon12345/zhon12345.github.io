---
import Icon from "@/components/Icon.astro";
---

<section id="home" class="relative flex min-h-[90vh] items-center justify-center">
	<div class="container text-center">
		<h1 class="mb-4 font-bold tracking-tight">Ng Zhun Onn</h1>

		<p class="text-text-secondary text-lg font-light md:text-xl lg:text-2xl">Student. Developer. FOSS enthusiast</p>
