---
import { Image } from "astro:assets";
import Flag from "@/assets/flag.png";
import Square from "@/assets/square.png";
import Portrait from "@/assets/portrait.png";
import Button from "@/components/Button.astro";

interface Props {
  summary?: boolean;
}

const { summary = false } = Astro.props;
---

{
  summary ? (
    <section id="about" class="bg-surface-elevated">
      <div class="container">
        <h4 class="text-primary mb-4 text-start text-sm uppercase">About Me</h4>
        <div class="flex flex-col items-center gap-4 lg:flex-row lg:justify-between">
          <p class="text-justify lg:max-w-3/4">
            A tech nerd, software engineer, Diploma in Information Technology
            holder, and Bachelor of Software Engineering student from
            <a href="https://tarc.edu.my/">TAR UMT</a>, based in Kuala Lumpur,
            <Image
              src={Flag}
              alt="Jalur Gemilang, the Malaysian flag"
              class="inline-block w-5 align-baseline"
            />
            Malaysia. I'm passionate about Free and Open Source Software (FOSS)
            and a strong advocate for digital privacy.
          </p>

          <Button href="/about">Read More</Button>
        </div>
      </div>
    </section>
  ) : (
    <div class="flex flex-col lg:flex-row lg:items-start lg:gap-8">
      <div class="mb-6 flex flex-1 justify-center overflow-hidden lg:mb-0 lg:justify-start">
        <Image
          src={Square}
          alt="A picture of Zhun Onn"
          class="block w-60 md:w-80 lg:hidden"
        />
        <Image
          src={Portrait}
          alt="A picture of Zhun Onn"
          height={400}
          class="hidden lg:block"
        />
      </div>

      <div class="*data-paragraph:text-pretty *:data-paragraph:text-justify lg:max-w-2/3">
        <p class="mb-4" data-paragraph>
          Hi, I’m Zhun Onn — a tech nerd, software engineer, Diploma in
          Information Technology holder, and Bachelor of Software Engineering
          student from
          <a href="https://tarc.edu.my/">TAR UMT</a>, based in Kuala Lumpur,
          <Image
            src={Flag}
            alt="Jalur Gemilang, the Malaysian flag"
            class="inline-block w-5 align-baseline"
          />
          Malaysia. I'm passionate about Free and Open Source Software (FOSS)
          and a strong advocate for digital privacy.
        </p>

        <p class="mb-6" data-paragraph>
          I specialize in full-stack development — building fast, maintainable,
          and scalable web applications. My experience spans working with both
          SQL and NoSQL databases, RESTful APIs, and modern tooling.
        </p>

        <div class="flex justify-start">
          <Button href="/resume.pdf">Resume</Button>
        </div>
      </div>
    </div>
  )
}
