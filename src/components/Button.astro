---
interface Props {
	href?: string;
	type?: "button" | "submit" | "reset";
	className?: string;
}

const { href, type = "button", className } = Astro.props;
const classes = ["bg-primary text-text-inverse rounded px-8 py-2", className];
---

{
	href ? (
		<a href={href} class:list={classes}>
			<slot />
		</a>
	) : (
		<button type={type} class:list={classes}>
			<slot />
		</button>
	)
}
