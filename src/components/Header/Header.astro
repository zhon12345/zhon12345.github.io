---
import Container from "@/components/Container.astro";
import ThemeToggle from "@/components/Header/ThemeToggle.astro";
import MobileMenu from "@/components/Header/MobileMenu.vue";

const menuItems = [
	{ name: "Home", href: "#home" },
	{ name: "About", href: "#about" },
	{ name: "Projects", href: "#projects" },
	{ name: "Contact", href: "#contact" },
];
---

<header class="bg-background fixed z-50 w-full md:shadow-xl/20">
	<Container>
		<nav class="flex h-16 items-center justify-between md:grid md:grid-cols-3 md:items-center">
			<div class="md:justify-self-start">
				<a class="text-xl font-semibold tracking-wider uppercase lg:text-2xl" href="/"> Ng Zhun Onn </a>
			</div>

			<ul class="hidden gap-6 justify-self-center md:flex lg:gap-8 xl:gap-10 2xl:gap-12">
				{
					menuItems.map((item) => (
						<li>
							<a href={item.href} class="hover:underline">
								{item.name}
							</a>
						</li>
					))
				}
			</ul>

			<div class="flex gap-4 md:justify-self-end">
				<ThemeToggle class="w-6 cursor-pointer md:w-7" />

				<MobileMenu menuItems={menuItems} client:load />
			</div>
		</nav>
	</Container>
</header>

<div id="dropdown"></div>
