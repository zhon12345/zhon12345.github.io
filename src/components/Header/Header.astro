---
import ThemeToggle from "@/components/Header/ThemeToggle.astro";
import MobileMenu from "@/components/Header/MobileMenu.vue";

const menuItems = [
	{ name: "Home", href: "/" },
	{ name: "About", href: "/about" },
	{ name: "Projects", href: "#" },
];
---

<header class="bg-surface-muted sticky top-0 z-50 h-16 w-full content-center">
	<nav class="container flex items-center justify-between py-0">
		<a id="header-title" class="text-xl font-semibold tracking-wider uppercase" href="/"> Ng Zhun Onn </a>

		<div class="flex justify-center gap-6">
			<ul class="hidden gap-6 md:flex">
				{
					menuItems.map((item) => (
						<li>
							<a href={item.href} class="hover:underline">
								{item.name}
							</a>
						</li>
					))
				}
			</ul>

			<ThemeToggle class="w-6 cursor-pointer" />

			<MobileMenu menuItems={menuItems} client:load />
		</div>
	</nav>
</header>

<div id="dropdown" class="md:hidden"></div>

<script is:inline>
	document.addEventListener("DOMContentLoaded", () => {
		const headerTitle = document.getElementById("header-title");
		const hero = document.getElementById("home");

		if (!headerTitle || !hero) return;

		const updateTitle = (entries) => {
			entries.forEach((entry) => {
				headerTitle.textContent = entry.isIntersecting ? "NZO" : "Ng Zhun Onn";
			});
		};

		const observer = new IntersectionObserver(updateTitle, {
			root: null,
			threshold: 0.6,
		});

		observer.observe(hero);
	});
</script>
