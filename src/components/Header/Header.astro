---
import ThemeToggle from "@/components/Header/ThemeToggle.astro";
import MobileMenu from "@/components/Header/MobileMenu.vue";

const menuItems = [
	{ name: "Home", href: "#home" },
	{ name: "About", href: "#about" },
	{ name: "Projects", href: "#projects" },
	{ name: "Contact", href: "#contact" },
];
---

<header class="bg-surface sticky top-0 z-50 h-16 w-full content-center md:shadow-xl/20">
	<nav class="container flex items-center justify-between">
		<a class="text-xl font-semibold tracking-wider uppercase" href="/"> Ng Zhun Onn </a>

		<div class="flex justify-center gap-6">
			<ul class="hidden gap-6 md:flex">
				{
					menuItems.map((item) => (
						<li>
							<a href={item.href} class="hover:underline">
								{item.name}
							</a>
						</li>
					))
				}
			</ul>

			<ThemeToggle class="w-6 cursor-pointer" />

			<MobileMenu menuItems={menuItems} client:load />
		</div>
	</nav>
</header>

<div id="dropdown"></div>
